# Keep secrets and personal data out of the image: the Dockerfile uses `COPY . .`,
# and anything copied in stays in a layer even if a volume later shadows the path.
.env
.env.*
!.env.example
data/

# Build noise
.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
.idea/
.vscode/
*.log
*.db
*.sqlite3
.DS_Store
README.md
docs/
