# =============================================================================
#  Postwright — configuration template
# =============================================================================
#  1. Copy this file:      cp .env.example .env
#  2. Open .env and fill in the values marked REQUIRED.
#  3. Never commit .env — it is listed in .gitignore for a reason.
#
#  Syntax rules (read these, they cause 90% of the problems):
#    - no spaces around "=":      KEY=value        not   KEY = value
#    - no quotes needed:          KEY=my value     not   KEY="my value"
#    - a line starting with # is disabled (commented out)
#    - lists are comma-separated, no spaces after the commas needed
# =============================================================================


# =============================================================================
#  1. TELEGRAM  —  REQUIRED
#  See README, section "Create the Telegram bot" for the click-by-click guide.
# =============================================================================

# From @BotFather after /newbot. Looks like 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# Your personal numeric Telegram ID. Get it from @userinfobot, or from
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates after messaging your bot.
TELEGRAM_CHAT_ID=


# =============================================================================
#  2. AI PROVIDERS  —  AT LEAST ONE REQUIRED
#
#  A provider is ACTIVE when it has BOTH <PREFIX>_API_KEY and <PREFIX>_MODEL.
#  Every active provider scores the trends (the final score is the average).
#  PRIMARY_LLM is the one that writes the persona card and the LinkedIn drafts;
#  if it fails, the next one in the list takes over.
#
#  Check what is active:   python main.py providers
#
#  API keys are pay-per-use and are NOT included in ChatGPT Plus,
#  Gemini Advanced, Claude Pro or X Premium subscriptions.
# =============================================================================

# Which provider writes the persona card and the drafts. Valid values: openai, gemini,
# anthropic, xai, mistral, deepseek, groq, openrouter, perplexity, inception.
# The built-in default is "openai"; this template sets gemini because it has the
# simplest signup and a free tier. Change it to whichever provider you configured.
PRIMARY_LLM=gemini

# Optional: restrict AND order the providers used for scoring.
# Empty = use every active provider. Fewer providers = lower cost.
# LLM_PROVIDERS=gemini,openai

# --- OpenAI (ChatGPT) · https://platform.openai.com/api-keys -----------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_WRITER_MODEL=                      # optional: stronger model, drafts only
# OPENAI_BASE_URL=https://api.openai.com/v1 # optional: Azure, Ollama, any OpenAI-compatible endpoint

# --- Google Gemini · https://aistudio.google.com/apikey ----------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_WRITER_MODEL=

# --- Anthropic Claude · https://console.anthropic.com/settings/keys ----------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WRITER_MODEL=claude-sonnet-5-5

# --- xAI Grok · https://console.x.ai -----------------------------------------
# No default model: copy an available model name from your xAI console.
# XAI_API_KEY=
# XAI_MODEL=
# XAI_WRITER_MODEL=

# --- Mistral AI (EU) · https://console.mistral.ai/api-keys -------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=

# --- DeepSeek · https://platform.deepseek.com/api_keys -----------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=

# --- Groq (fast, cheap open models) · https://console.groq.com/keys ----------
# GROQ_API_KEY=
# GROQ_MODEL=

# --- OpenRouter (one key, many models) · https://openrouter.ai/keys ----------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- Perplexity · https://www.perplexity.ai/settings/api ---------------------
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=

# --- Inception Mercury · https://platform.inceptionlabs.ai -------------------
# INCEPTION_API_KEY=
# INCEPTION_MODEL=mercury-2
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1


# =============================================================================
#  3. SCHEDULE
# =============================================================================

# IANA timezone name, e.g. Europe/Rome, Europe/London, America/New_York
TIMEZONE=Europe/Rome

# The three settings below are commented out: leaving them so uses the documented
# defaults (30 / 60 / 11,16,21). Uncomment to override.

# How often it searches and scores. Allowed: any divisor of 60 (5, 10, 15, 20, 30...)
# or a multiple of 60 that divides 24h (60, 120, 180, 240, 360, 480, 720).
# SCAN_INTERVAL_MINUTES=30

# How often it sends you the Telegram digest. Same allowed values.
# Must be >= SCAN_INTERVAL_MINUTES.
# DIGEST_INTERVAL_MINUTES=60

# Times of day when a LinkedIn draft is written (24h clock, comma-separated, no spaces).
# DRAFT_HOURS=11,16,21

# How far back a draft looks for candidate trends.
DRAFT_LOOKBACK_HOURS=8

# If writing or sending a draft fails, try once more after this many minutes.
# A slot the editor deliberately skips is not a failure and is never retried.
# Set to 0 to wait for the next scheduled slot instead.
DRAFT_RETRY_MINUTES=5

# How long a 👍 keeps a news item eligible for a draft.
VOTE_LOOKBACK_HOURS=48

# true = send the digest even when nothing is above threshold (proof of life).
SEND_EMPTY_HEARTBEAT=false


# =============================================================================
#  4. FILTERING AND COST CONTROL
# =============================================================================

# Minimum affinity score (0-10) for a trend to reach the digest or a draft.
MIN_SCORE=7

# Max trends listed in one digest (the rest stay available for drafts).
MAX_NOTIFY=10

# Lower these if you hit HTTP 429 (rate limit) or want to spend less.
# SCAN_BATCH_SIZE=15            # how many posts are scored in one AI call
# MAX_NEW_POSTS_PER_SCAN=120    # cap on new posts scored per scan
# MAX_POST_AGE_HOURS=24         # ignore anything older than this


# =============================================================================
#  5. SOURCES
#  Google Trends, Google News and Hacker News need no keys.
#  WARNING: if a line below is present in .env, it REPLACES the built-in default.
# =============================================================================

# Two-letter country code for Google Trends and Google News (e.g. US, GB, IT, DE).
GOOGLE_TRENDS_GEO=US

# Language of the Google News results (two-letter code, e.g. en, it, de).
# Set it to the language you want to read the news in.
NEWS_LANGUAGE=en

# Google News queries, comma-separated. Put your own topics here.
NEWS_QUERIES=artificial intelligence Europe,technology innovation,startup funding,research funding Horizon Europe

# Hacker News on/off.
HN_ENABLED=true

# Extra RSS/Atom feeds, comma-separated full URLs.
# RSS_FEEDS=https://example.com/feed.xml,https://example.org/rss

# Substack publications: append /feed to the publication URL.
# These are merged into RSS_FEEDS. NOTE the exact spelling: SUBSTACK_FEEDS.
# Some publications block non-browser clients and answer 403: see docs/GUIDE.md.
# SUBSTACK_FEEDS=https://<publication>.substack.com/feed,https://<another>.com/feed

# --- Reddit (optional) · create a "script" app at reddit.com/prefs/apps ------
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=postwright/1.0
# SUBREDDITS=technology,Futurology,MachineLearning,europe

# --- X / Twitter (optional, paid API plan required) --------------------------
# X_BEARER_TOKEN=
# X_QUERY=(AI OR startup) lang:en -is:retweet -is:reply


# =============================================================================
#  6. PATHS (optional — defaults are fine)
# =============================================================================

# DB_PATH=data/trends.db
# PERSONA_PATH=data/persona_card.json

# How many days of scored posts to keep. Once a week the database drops anything
# older, except posts you voted on or that produced a draft, which are kept forever.
# Roughly 1 KB per post, so at ~500 posts/day: 30 days ~13 MB, 90 days ~40 MB.
# Set to 0 to keep everything.
# RETENTION_DAYS=90
